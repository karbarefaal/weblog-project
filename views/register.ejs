<form class="form-signin" action="/users/register" method="POST">
    <h1 class="h3 mb-3 fw-normal">ثبت نام کاربر</h1>
    <%- include("./includes/messages.ejs") %>
    <label for="inputFullname" class="sr-only">نام و نام خانوادگی</label>
    <input 
        id="inputFullname"
        name="fullname"
        class="form-control mb-2" 
        placeholder="نام و نام خانوادگی"
        required
        autofocus
    >
    <label for="inputEmail" class="sr-only">آدرس ایمیل</label>
    <input 
        id="inputEmail"    
        type="email" 
        name="email"
        class="form-control m-2" 
        placeholder="آدرس ایمیل"
        required
    >
    <label for="inputPassword" class="sr-only">کلمه عبور</label>
    <input 
        id="inputPassword"    
        type="password" 
        name="password"
        class="form-control m-2" 
        placeholder="کلمه عبور"
        required
    >
    <label for="inputConfirmPassword" class="sr-only">تکرار کلمه عبور</label>
    <input 
        id="inputConfirmPassword"    
        type="password" 
        name="confirmPassword"
        class="form-control" 
        placeholder="تکرار کلمه عبور"
        required
    >
    <div class="checkbox mb-3">
        <label>
           <a href="/users/login">اکانت کاربری دارم</a>
        </label>
    </div>
    <button class="btn btn-lg btn-primary btn-block" type="submit">ثبت نام</button>
</form>
