<form class="form-signin" action="/users/login" method="POST">
    <h1 class="h3 mb-3 fw-normal">ورود به بخش مدیریت</h1>
    <%- include("./includes/loginMessages.ejs") %>
    <label for="inputEmail" class="sr-only">آدرس ایمیل</label>
    <input 
        id="inputEmail"    
        type="email" 
        name="email"
        class="form-control m-2" 
        placeholder="آدرس ایمیل"
        required
    >
    <label for="inputPassword" class="sr-only">کلمه عبور</label>
    <input 
        id="inputPassword"    
        type="password" 
        name="password"
        class="form-control m-2" 
        placeholder="کلمه عبور"
        required
    >
    <div class="checkbox mb-3">
        <label>
            <input name="remember" type="checkbox" value="remember-me"> من را به خاطر بسپار
        </label>
    </div>
    <div class="form-group">
        <div class="g-recaptcha" data-sitekey="6LeNXaMfAAAAAKA7YP5ZFGWwF3okY5ilfrxkZLz7"></div>
    </div>
    
    <button class="w-100 btn btn-lg btn-primary" type="submit">ورود</button>
</form>
