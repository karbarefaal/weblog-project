<%- include("./includes/navbar.ejs") %>
<!-- Page Content -->
<div class="container mt-5">
    <div class="row">
        <!-- Post Content Column -->
        <div class="col">
            <!-- Title -->
            <h1 class="mt-4"><%= post.title %></h1>

            <!-- Author -->
            <p class="lead">
                نوشته شده توسط :
                <a href="#"><%= post.user.fullname %></a>
            </p>

            <hr />

            <!-- Date/Time -->
            <p>تاریخ انتشار : <%= formatDate(post.createAt)%></p>

            <hr />

            <!-- Preview Image -->
            <div class="text-center">
                <img
                    class="img-fluid rounded"
                    src="http://localhost:3000/uploads/thumbnails/<%= post.thumbnail %>"
                    alt=""
                />
            </div>

            <hr />

            <!-- Post Content -->
            <p class="text-justify"><%- post.body %></p>

            <hr />

            <!-- Comments Form -->
            <div class="card my-4">
                <h5 class="card-header">نظر خود را بنویسید:</h5>
                <div class="card-body">
                    <form action="/comment/<%= post._id %>" method="POST">
                        <div class="form-group">
                            <input class="form-control" type="text" name="name" placeholder="نام خود را وارد کنید" required>
                        </div>
                        <div class="form-group">
                            <textarea class="form-control" rows="3" name="com" placeholder="نظر خود را وارد کنید" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            ثبت نظر
                        </button>
                    </form>
                </div>
            </div>

            <ul>
                <% for(let i =0;i<comments.length;i++){ %>
                <li>
                    <div class="media mb-4">
                        <img
                            class="d-flex mr-3 rounded-circle"
                            src="http://place-hold.it/50x50"
                            alt=""
                        />
                        <div class="media-body">
                            <h5 class="mt-0"><%= comments[i].name %></h5>
                            <%= comments[i].com %>
                        </div>
                    </div>
                </li>
                <% } %>
            </ul>


            
            <!-- Comment with nested comments -->
            <!-- <div class="media mb-4">
                <img
                    class="d-flex mr-3 rounded-circle"
                    src="http://place-hold.it/50x50"
                    alt=""
                />
                <div class="media-body">
                    <h5 class="mt-0">علی سجادی</h5>
                    نظر تست

                    <div class="media mt-4">
                        <img
                            class="d-flex mr-3 rounded-circle"
                            src="http://place-hold.it/50x50"
                            alt=""
                        />
                        <div class="media-body">
                            <h5 class="mt-0">علی سجادی</h5>
                            نظر تست
                        </div>
                    </div>
                </div>
            </div> -->
        </div>
    </div>
</div>
<%- include('./includes/footer.ejs') %>